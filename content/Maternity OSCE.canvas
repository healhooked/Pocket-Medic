		{"id":"3c6c8b2694045968","type":"group","x":2255,"y":886,"width":290,"height":180,"label":"Retrospective:"},
		{"id":"623a39abcc5dbf8c","type":"text","text":"## 30 Seconds\n- CPR 3:1\n- IV Access < 1 min Consider IO\n- Adrenaline\n- Sodium Chloride 0.9%","x":2100,"y":479,"width":250,"height":250},
		{"id":"9c1f8703c616ff85","type":"text","text":"## 30 Seconds\n- Normothermia Maintained  \n- IPPV (40 - 60 / per min, room air)\n- SpO2","x":1412,"y":479,"width":250,"height":250},
		{"id":"4c0364ad8543b1ac","type":"text","text":"## 30 Seconds\n-  O2\n-  PEEP\n- 2 Handed BVM Technique","x":1760,"y":479,"width":250,"height":250},
		{"id":"1696be869a6127f0","type":"text","text":"\n *Consider ?* [[Hypovolaemia]] Treatment Pathway\n -  [[Intraosseous (IO) Access]] ?\n\n *Consider?*\n  - [[External aortic compression]]\n  - [[Bimanual Compression]]\n  \n","x":1480,"y":1386,"width":363,"height":223},
		{"id":"16b8960992bd27d8","type":"text","text":"APGAR 1 minute","x":2275,"y":906,"width":250,"height":50},
		{"id":"95a7d379de980a38","type":"text","text":"APGAR 5 min","x":2275,"y":986,"width":250,"height":60},
		{"id":"f777b55d172cc31e","type":"text","text":"APGAR 1 minute","x":-460,"y":-140,"width":250,"height":50},
		{"id":"c7dafddb5a19905a","type":"text","text":"APGAR 5 min","x":-460,"y":-60,"width":250,"height":60},
