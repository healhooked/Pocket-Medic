		{"id":"e3aa2c8f120e9ff5","type":"text","text":"### Cardiovascular Diff Dx:\n- Congestive Heart Failure\n- Cardiac Arrythmia\n- Pericarditis\n- Atrial Fibrillation\n- Hypertensive Heart Disease \n- Cardiomyopathies\n- Syncope\n- SVT\n","x":3911,"y":-465,"width":380,"height":287,"color":"1"},
